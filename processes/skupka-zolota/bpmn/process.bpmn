<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GoldBuying" targetNamespace="https://sks.local/business-processes/gold-buying/v1" exporter="Business Process BPMN Kit" exporterVersion="1.0.0">
  <bpmn:message id="Message_ClientRequest" name="Обращение клиента о продаже золота или лома" />
  <bpmn:message id="Message_FinMonitoringNotice" name="Уведомление об отказе предъявить документ, удостоверяющий личность" />
  <bpmn:message id="Message_ProcessHandoff" name="Изделие и учётные данные готовы к следующему процессу" />
  <bpmn:collaboration id="Collaboration_GoldBuying" name="Скупка золота и драгоценных металлов">
    <bpmn:participant id="Participant_Client" name="Клиент" />
    <bpmn:participant id="Participant_BuyingOrganization" name="Организация · клиентская скупка" processRef="Process_GoldBuying" />
    <bpmn:participant id="Participant_FinMonitoring" name="Финансовый мониторинг · связанный контур" />
    <bpmn:participant id="Participant_NextProcess" name="Следующий внутренний процесс · цель требует утверждения" />
    <bpmn:messageFlow id="MessageFlow_ClientRequest" name="Хочет безвозвратно продать изделие" sourceRef="Participant_Client" targetRef="StartEvent_ClientRequest" messageRef="Message_ClientRequest" />
    <bpmn:messageFlow id="MessageFlow_FinMonitoring" name="Незамедлительное уведомление" sourceRef="SendTask_NotifyFinMonitoring" targetRef="Participant_FinMonitoring" messageRef="Message_FinMonitoringNotice" />
    <bpmn:messageFlow id="MessageFlow_NextProcess" name="Передача изделия и учётных данных" sourceRef="EndEvent_Success" targetRef="Participant_NextProcess" messageRef="Message_ProcessHandoff" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GoldBuying" name="Скупка золота и драгоценных металлов · текущая модель · ожидает утверждения" isExecutable="false">
    <bpmn:documentation textFormat="text/markdown">Технически переносимая модель BPMN 2.0.2. Граница, владелец, порядок финальных действий и некоторые связанные процессы требуют решения владельца. Модель предназначена для обсуждения и импорта, но не является исполняемым регламентом.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GoldBuying">
      <bpmn:lane id="Lane_ProductSpecialist" name="Товаровед / товаровед-кассир">
        <bpmn:flowNodeRef>StartEvent_ClientRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyClientRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OtherProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ItemRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MarkingCodeCheckRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckMarkingCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MarkingCodeValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MarkingChecksComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MarkingProcessHandoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculatePreliminaryPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IdentificationComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IdentityDocumentRefused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_NotifyFinMonitoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IdentityRejectJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IdentityRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgreeTermsAndPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighEvaluationNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_HighEvaluation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferStandardPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TermsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TermsAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoDeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyTermsAndDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignPostAndConfirmPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostedError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_HandlePostedError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ErrorRouted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SecureAndPrepareHandoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalConfirmations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ClientRequest" name="Клиент хочет продать золото или лом">
      <bpmn:outgoing>Flow_ClientRequestToClarification</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ClientRequest" messageRef="Message_ClientRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ClarifyClientRequest" name="Уточнить запрос клиента">
      <bpmn:documentation>Подтвердить, что клиент выбирает безвозвратную продажу золота или лома, а не залог, технику, антиквариат или только консультацию.</bpmn:documentation>
      <bpmn:incoming>Flow_ClientRequestToClarification</bpmn:incoming>
      <bpmn:outgoing>Flow_ClarificationToScopeDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Scope" name="Это безвозвратная скупка золота?">
      <bpmn:incoming>Flow_ClarificationToScopeDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_GoldBuyingConfirmedToItemInspection</bpmn:outgoing>
      <bpmn:outgoing>Flow_OtherRequestToAlternateProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_OtherProcess" name="Передано в другой процесс или консультацию">
      <bpmn:incoming>Flow_OtherRequestToAlternateProcess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_InspectItem" name="Проверить изделие">
      <bpmn:documentation>Определить металл, пробу, вес, вставки и состояние. Способ проверки должен соответствовать действующему регламенту.</bpmn:documentation>
      <bpmn:incoming>Flow_GoldBuyingConfirmedToItemInspection</bpmn:incoming>
      <bpmn:outgoing>Flow_ItemInspectionToAcceptanceDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ItemAccepted" name="Изделие допустимо принять?">
      <bpmn:incoming>Flow_ItemInspectionToAcceptanceDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ItemAcceptedToMarkingCheckDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ItemRejectedToRejectionEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ItemRejected" name="Отказ до оформления · изделие не принято">
      <bpmn:incoming>Flow_ItemRejectedToRejectionEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MarkingCodeCheckRequired" name="Нужно проверить маркировочный код изделия?">
      <bpmn:incoming>Flow_ItemAcceptedToMarkingCheckDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkingCheckRequiredToCodeCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_MarkingCheckNotRequiredToMarkingMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckMarkingCode" name="Проверить маркировочный код, статус и вес изделия">
      <bpmn:documentation>Только для категорий, перечисленных во внутренних правилах. Проверить читаемость, допустимый статус и совпадение веса с профильной государственной информационной системой.</bpmn:documentation>
      <bpmn:incoming>Flow_MarkingCheckRequiredToCodeCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkingCodeCheckedToValidationDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MarkingCodeValid" name="Проверка маркировочного кода пройдена?">
      <bpmn:incoming>Flow_MarkingCodeCheckedToValidationDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkingCodeValidToMarkingMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_MarkingCodeInvalidToMarkingProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_MarkingProcessHandoff" name="Передано в процесс маркировки по внутренним правилам">
      <bpmn:incoming>Flow_MarkingCodeInvalidToMarkingProcess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MarkingChecksComplete">
      <bpmn:incoming>Flow_MarkingCheckNotRequiredToMarkingMerge</bpmn:incoming>
      <bpmn:incoming>Flow_MarkingCodeValidToMarkingMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkingChecksCompleteToPreliminaryPrice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CalculatePreliminaryPrice" name="Рассчитать предварительную цену">
      <bpmn:documentation>Внести категорию, пробу, вес, вычет вставок и описание. Использовать тариф и расчёт системы, не ручную формулу из отдельного интервью.</bpmn:documentation>
      <bpmn:incoming>Flow_MarkingChecksCompleteToPreliminaryPrice</bpmn:incoming>
      <bpmn:outgoing>Flow_PreliminaryPriceToClientIdentification</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IdentifyClient" name="Идентифицировать клиента">
      <bpmn:documentation>Проверить возраст от 18 лет, допустимый действующий документ, удостоверяющий личность, гражданство и обязательные сведения, предусмотренные внутренними правилами и формой рабочей системы.</bpmn:documentation>
      <bpmn:incoming>Flow_PreliminaryPriceToClientIdentification</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientIdentificationToCompletenessDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IdentificationComplete" name="Полная идентификация завершена?">
      <bpmn:incoming>Flow_ClientIdentificationToCompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentificationCompleteToTermsAgreement</bpmn:outgoing>
      <bpmn:outgoing>Flow_IdentificationIncompleteToDocumentRefusalDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_IdentityDocumentRefused" name="Клиент отказался предъявить документ, удостоверяющий личность?">
      <bpmn:incoming>Flow_IdentificationIncompleteToDocumentRefusalDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentityDocumentRefusedToFinancialMonitoring</bpmn:outgoing>
      <bpmn:outgoing>Flow_OtherIdentificationFailureToRejectionMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask_NotifyFinMonitoring" name="Уведомить финансовый мониторинг" messageRef="Message_FinMonitoringNotice">
      <bpmn:documentation>При отказе клиента предъявить документ, удостоверяющий личность, отказать в операции и незамедлительно уведомить отдел финансового мониторинга в установленном порядке.</bpmn:documentation>
      <bpmn:incoming>Flow_IdentityDocumentRefusedToFinancialMonitoring</bpmn:incoming>
      <bpmn:outgoing>Flow_FinancialMonitoringNotifiedToRejectionMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IdentityRejectJoin">
      <bpmn:incoming>Flow_OtherIdentificationFailureToRejectionMerge</bpmn:incoming>
      <bpmn:incoming>Flow_FinancialMonitoringNotifiedToRejectionMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectionMergeToIdentificationRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_IdentityRejected" name="Отказ до оформления · идентификация не завершена">
      <bpmn:incoming>Flow_RejectionMergeToIdentificationRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_AgreeTermsAndPrice" name="Согласовать условия и цену">
      <bpmn:documentation>Сообщить клиенту условия и стандартную сумму. Порог, полномочия, канал и срок согласования повышенной оценки пока не утверждены единым правилом.</bpmn:documentation>
      <bpmn:incoming>Flow_IdentificationCompleteToTermsAgreement</bpmn:incoming>
      <bpmn:outgoing>Flow_TermsAgreementToHighEvaluationDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HighEvaluationNeeded" name="Нужна повышенная оценка?">
      <bpmn:incoming>Flow_TermsAgreementToHighEvaluationDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_HighEvaluationNotRequiredToTermsMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighEvaluationRequiredToApprovalProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallActivity_HighEvaluation" name="Согласовать повышенную оценку" calledElement="HIGH-EVALUATION-APPROVAL">
      <bpmn:documentation>Связанный процесс-кандидат. Точная матрица полномочий, канал и срок согласования требуют решения владельца процесса.</bpmn:documentation>
      <bpmn:incoming>Flow_HighEvaluationRequiredToApprovalProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalProcessCompletedToDecision</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_HighApproved" name="Повышенная оценка согласована?">
      <bpmn:incoming>Flow_ApprovalProcessCompletedToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_HighEvaluationApprovedToTermsMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighEvaluationRejectedToStandardPriceOffer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_OfferStandardPrice" name="Предложить стандартную цену">
      <bpmn:incoming>Flow_HighEvaluationRejectedToStandardPriceOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_StandardPriceOfferToTermsMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TermsJoin">
      <bpmn:incoming>Flow_HighEvaluationNotRequiredToTermsMerge</bpmn:incoming>
      <bpmn:incoming>Flow_HighEvaluationApprovedToTermsMerge</bpmn:incoming>
      <bpmn:incoming>Flow_StandardPriceOfferToTermsMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_TermsMergeToClientAcceptanceDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TermsAccepted" name="Клиент принял итоговые условия?">
      <bpmn:incoming>Flow_TermsMergeToClientAcceptanceDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_TermsAcceptedToDocumentPreparation</bpmn:outgoing>
      <bpmn:outgoing>Flow_TermsRejectedToNoDeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_NoDeal" name="Обращение завершено без сделки">
      <bpmn:incoming>Flow_TermsRejectedToNoDeal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PrepareDocuments" name="Подготовить документы в рабочей системе">
      <bpmn:documentation>Заполнить в рабочей системе документ «Квитанция скупки»: указать организацию, склад, тариф, клиента, способ выплаты и строки изделий; подготовить квитанцию и договор.</bpmn:documentation>
      <bpmn:incoming>Flow_TermsAcceptedToDocumentPreparation</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsPreparedToVerification</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyTermsAndDocuments" name="Проверить условия и документы">
      <bpmn:documentation>Клиент проверяет описание изделия и сумму. Состав и количество документов должны определяться действующей инструкцией.</bpmn:documentation>
      <bpmn:incoming>Flow_DocumentsPreparedToVerification</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsVerifiedToSigningPostingPayment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SignPostAndConfirmPayment" name="Подписать документы, провести операцию и подтвердить выплату">
      <bpmn:documentation>Модель намеренно не задаёт точный порядок печати, подписи, проведения и выплаты: источники расходятся, а упомянутые в одном из внутренних документов отдельные инструкции не найдены. Статус «Принято» сам по себе не подтверждает выплату и передачу на хранение.</bpmn:documentation>
      <bpmn:incoming>Flow_DocumentsVerifiedToSigningPostingPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_SigningPostingPaymentToErrorDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PostedError" name="После проведения выявлена ошибка?">
      <bpmn:incoming>Flow_SigningPostingPaymentToErrorDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_NoPostedErrorToSecureHandoff</bpmn:outgoing>
      <bpmn:outgoing>Flow_PostedErrorToCorrectionProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallActivity_HandlePostedError" name="Исправить проведённую операцию" calledElement="POSTED-OPERATION-CORRECTION">
      <bpmn:documentation>В день операции и только когда это разрешено — отдельная ошибочная операция или отмена. Поздние случаи, движение партии и регистрация в профильной государственной информационной системе требуют передачи на отдельное рассмотрение.</bpmn:documentation>
      <bpmn:incoming>Flow_PostedErrorToCorrectionProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrectionProcessToErrorRoutedEnd</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_ErrorRouted" name="Операция передана на исправление или эскалацию">
      <bpmn:incoming>Flow_CorrectionProcessToErrorRoutedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SecureAndPrepareHandoff" name="Обеспечить защищённое хранение и подготовить передачу">
      <bpmn:documentation>Маркировать или упаковать изделие принятым способом, поместить в защищённое хранение и подготовить реестр, акт или иные данные для следующего процесса.</bpmn:documentation>
      <bpmn:incoming>Flow_NoPostedErrorToSecureHandoff</bpmn:incoming>
      <bpmn:outgoing>Flow_SecureHandoffToFinalConfirmationDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalConfirmations" name="Подтверждены приём изделия, выплата и хранение?">
      <bpmn:incoming>Flow_SecureHandoffToFinalConfirmationDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalConfirmationsCompleteToSuccessEnd</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalConfirmationsIncompleteToIncompleteEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_NotComplete" name="Не считать сделку завершённой">
      <bpmn:incoming>Flow_FinalConfirmationsIncompleteToIncompleteEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Success" name="Сделка завершена · готово к следующему процессу">
      <bpmn:incoming>Flow_FinalConfirmationsCompleteToSuccessEnd</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_NextProcess" messageRef="Message_ProcessHandoff" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ClientRequestToClarification" sourceRef="StartEvent_ClientRequest" targetRef="Task_ClarifyClientRequest" />
    <bpmn:sequenceFlow id="Flow_ClarificationToScopeDecision" sourceRef="Task_ClarifyClientRequest" targetRef="Gateway_Scope" />
    <bpmn:sequenceFlow id="Flow_GoldBuyingConfirmedToItemInspection" name="Да" sourceRef="Gateway_Scope" targetRef="Task_InspectItem" />
    <bpmn:sequenceFlow id="Flow_OtherRequestToAlternateProcess" name="Нет · другой вид обращения" sourceRef="Gateway_Scope" targetRef="EndEvent_OtherProcess" />
    <bpmn:sequenceFlow id="Flow_ItemInspectionToAcceptanceDecision" sourceRef="Task_InspectItem" targetRef="Gateway_ItemAccepted" />
    <bpmn:sequenceFlow id="Flow_ItemAcceptedToMarkingCheckDecision" name="Да" sourceRef="Gateway_ItemAccepted" targetRef="Gateway_MarkingCodeCheckRequired" />
    <bpmn:sequenceFlow id="Flow_ItemRejectedToRejectionEnd" name="Нет" sourceRef="Gateway_ItemAccepted" targetRef="EndEvent_ItemRejected" />
    <bpmn:sequenceFlow id="Flow_MarkingCheckRequiredToCodeCheck" name="Да" sourceRef="Gateway_MarkingCodeCheckRequired" targetRef="Task_CheckMarkingCode" />
    <bpmn:sequenceFlow id="Flow_MarkingCheckNotRequiredToMarkingMerge" name="Нет" sourceRef="Gateway_MarkingCodeCheckRequired" targetRef="Gateway_MarkingChecksComplete" />
    <bpmn:sequenceFlow id="Flow_MarkingCodeCheckedToValidationDecision" sourceRef="Task_CheckMarkingCode" targetRef="Gateway_MarkingCodeValid" />
