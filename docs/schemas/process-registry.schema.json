{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "business-process-bpmn-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "processes"],
  "properties": {
    "schema": { "const": "business-process-bpmn-registry/v1" },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["process_id", "title", "status", "business_status", "bpmn_ref", "meta_ref", "navigation_ref"],
        "properties": {
          "process_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "review-ready", "rework", "approved", "rejected"] },
          "business_status": { "enum": ["pending_human_decision", "canonical", "rejected"] },
          "bpmn_ref": { "type": "string", "pattern": "\\.bpmn$" },
          "meta_ref": { "type": "string", "pattern": "\\.json$" },
          "navigation_ref": { "type": "string", "pattern": "\\.html$" }
        }
      }
    }
  }
}
