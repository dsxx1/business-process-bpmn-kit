{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "business-process-bpmn-decisions/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "process_id", "model_version", "decisions"],
  "properties": {
    "schema": { "const": "business-process-bpmn-decisions/v1" },
    "process_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "model_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "question_id", "outcome", "actor", "decided_at", "bpmn_sha256", "evidence_sha256"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 3 },
          "question_id": { "type": "string", "pattern": "^Q-[A-Z0-9-]+-[0-9]{3}$" },
          "outcome": { "enum": ["approve", "rework", "reject"] },
          "actor": { "type": "string", "minLength": 3 },
          "decided_at": { "type": "string", "format": "date-time" },
          "bpmn_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "evidence_sha256": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    }
  }
}
